# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Spring Boot backend
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/portfolio
DB_USERNAME=portfolio
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-bytes-for-hs256

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Angular admin container
ADMIN_PORT=8081

# React Router public frontend container
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8080/api/v1/portfolio
